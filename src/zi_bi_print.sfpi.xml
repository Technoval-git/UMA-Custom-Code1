   <cls:CL_FP_CODING id="o5">
    <CL_FP_INTERFACE_DATA_CHANGED classVersion="1">
     <INTERFACE_DATA href="#o1"/>
    </CL_FP_INTERFACE_DATA_CHANGED>
    <CL_FP_CODING classVersion="1">
     <INPUT_PARAMETERS/>
     <OUTPUT_PARAMETERS/>
     <INITIALIZATION>
      <FPCLINE>TYPES : BEGIN OF ty_vbeln,</FPCLINE>
      <FPCLINE>          vbeln TYPE vbeln,</FPCLINE>
      <FPCLINE>          posnr TYPE posnr_vl,</FPCLINE>
      <FPCLINE>        END OF ty_vbeln.</FPCLINE>
      <FPCLINE>DATA : lv_matnr TYPE matnr.</FPCLINE>
      <FPCLINE>DATA : lv_vbeln TYPE ty_vbeln.</FPCLINE>
      <FPCLINE>DATA : lt_vbeln TYPE TABLE OF ty_vbeln.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>DATA(lt_ordim_o) = ordim_o.</FPCLINE>
      <FPCLINE>LOOP AT lt_ordim_o INTO DATA(wa_ordim_o).</FPCLINE>
      <FPCLINE>  CALL FUNCTION &apos;CONVERSION_EXIT_MDLPD_OUTPUT&apos;</FPCLINE>
      <FPCLINE>    EXPORTING</FPCLINE>
      <FPCLINE>      input  = wa_ordim_o-matid</FPCLINE>
      <FPCLINE>    IMPORTING</FPCLINE>
      <FPCLINE>      output = lv_matnr.</FPCLINE>
      <FPCLINE>  gs_final-lgnum = wa_ordim_o-lgnum.</FPCLINE>
      <FPCLINE>  gs_final-tanum = wa_ordim_o-tanum.</FPCLINE>
      <FPCLINE>  gs_final-matid   = wa_ordim_o-matid.</FPCLINE>
      <FPCLINE>  gs_final-vsolm   = wa_ordim_o-vsolm.</FPCLINE>
      <FPCLINE>  gs_final-meins   = wa_ordim_o-meins.</FPCLINE>
      <FPCLINE>  gs_final-batchid = wa_ordim_o-batchid.</FPCLINE>
      <FPCLINE>  gs_final-vlpla   = wa_ordim_o-vlpla.</FPCLINE>
      <FPCLINE>  gs_final-nlpla   = wa_ordim_o-nlpla.</FPCLINE>
      <FPCLINE>  gs_final-matnr   = lv_matnr.</FPCLINE>
      <FPCLINE>  gs_final-vlenr    = wa_ordim_o-vlenr.</FPCLINE>
      <FPCLINE>  gs_final-nlenr    = wa_ordim_o-nlenr.</FPCLINE>
      <FPCLINE>  MOVE-CORRESPONDING wa_ordim_o TO gs_final.</FPCLINE>
      <FPCLINE>  APPEND gs_final TO gt_final.</FPCLINE>
      <FPCLINE>  CLEAR : wa_ordim_o,gs_final,lv_matnr.</FPCLINE>
      <FPCLINE>ENDLOOP.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>IF gt_final IS NOT INITIAL.</FPCLINE>
      <FPCLINE>  SELECT matnr, maktx FROM makt INTO TABLE @DATA(lt_makt) FOR ALL ENTRIES IN @gt_final</FPCLINE>
      <FPCLINE>     WHERE matnr = @gt_final-matnr AND spras = &apos;E&apos;.</FPCLINE>
      <FPCLINE>  SELECT lgnum,matid,quan FROM /scwm/aqua INTO TABLE @DATA(lt_quan) FOR ALL ENTRIES IN @gt_final</FPCLINE>
      <FPCLINE>    WHERE lgnum = @gt_final-lgnum AND matid = @gt_final-matid AND cat = &apos;F2&apos;.</FPCLINE>
      <FPCLINE>  SELECT pickey,picpos,matnr FROM picps INTO TABLE @DATA(lt_PICPS)</FPCLINE>
      <FPCLINE>  FOR ALL ENTRIES IN @gt_final WHERE matnr = @gt_final-matnr.</FPCLINE>
      <FPCLINE>  IF lt_PICPS IS NOT INITIAL.</FPCLINE>
      <FPCLINE>    LOOP AT lt_PICPS INTO DATA(wa_picps).</FPCLINE>
      <FPCLINE>      IF wa_picps-picpos IS NOT INITIAL.</FPCLINE>
      <FPCLINE>        wa_picps-picpos = wa_picps-picpos - 1.</FPCLINE>
      <FPCLINE>      ENDIF.</FPCLINE>
      <FPCLINE>      MODIFY lt_PICPS FROM wa_picps.</FPCLINE>
      <FPCLINE>      CLEAR : wa_picps.</FPCLINE>
      <FPCLINE>    ENDLOOP.</FPCLINE>
      <FPCLINE>    SELECT pickey,picpos, matnr FROM picps INTO TABLE @DATA(lt_picps1) FOR ALL ENTRIES IN @lt_picps</FPCLINE>
      <FPCLINE>   WHERE pickey = @lt_picps-pickey AND  picpos =  @lt_picps-picpos.</FPCLINE>
      <FPCLINE>  ENDIF.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE>IF lt_ordim_o IS NOT INITIAL.</FPCLINE>
      <FPCLINE>  SELECT docid, refdocno,refitemno FROM /scdl/db_refdoc INTO TABLE @DATA(lt_refdocno) FOR ALL ENTRIES IN @lt_ordim_o</FPCLINE>
      <FPCLINE>     WHERE docid = @lt_ordim_o-rdocid AND itemid  = @lt_ordim_o-qitmid</FPCLINE>
      <FPCLINE>  AND doccat = @lt_ordim_o-rdoccat AND refdoccat = &apos;ERP&apos;.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>LOOP AT lt_refdocno INTO DATA(wa4).</FPCLINE>
      <FPCLINE>  lv_vbeln-vbeln = wa4-refdocno.</FPCLINE>
      <FPCLINE>  lv_vbeln-posnr = wa4-refitemno.</FPCLINE>
      <FPCLINE>  APPEND lv_vbeln TO lt_vbeln.</FPCLINE>
      <FPCLINE>  CLEAR : lv_vbeln,wa4.</FPCLINE>
      <FPCLINE>ENDLOOP.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>IF lt_vbeln IS NOT INITIAL.</FPCLINE>
      <FPCLINE>  SELECT vbeln,posnr,matnr,werks,lgort,vgbel,vgpos, /dbe/vbeln AS vssvbeln,/dbe/posnr AS vssposnr</FPCLINE>
      <FPCLINE>    FROM lips INTO TABLE @DATA(lt_lips)</FPCLINE>
      <FPCLINE>  FOR ALL ENTRIES IN @lt_vbeln WHERE vbeln = @lt_vbeln-vbeln.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>SORT gt_final BY matnr.</FPCLINE>
      <FPCLINE>SORT lt_lips BY matnr.</FPCLINE>
      <FPCLINE>LOOP AT gt_final INTO DATA(wa3).</FPCLINE>
      <FPCLINE>  READ TABLE lt_makt ASSIGNING FIELD-SYMBOL(&lt;fs_makt&gt;) WITH KEY matnr = wa3-matnr.</FPCLINE>
      <FPCLINE>  IF sy-subrc = 0.</FPCLINE>
      <FPCLINE>    IF &lt;fs_makt&gt; IS ASSIGNED.</FPCLINE>
      <FPCLINE>      wa3-maktx = &lt;fs_makt&gt;-maktx.</FPCLINE>
      <FPCLINE>    ENDIF.</FPCLINE>
      <FPCLINE>  ENDIF.</FPCLINE>
      <FPCLINE>  READ TABLE lt_lips ASSIGNING FIELD-SYMBOL(&lt;fs_lips&gt;) WITH KEY matnr = wa3-matnr.</FPCLINE>
      <FPCLINE>  IF sy-subrc = 0.</FPCLINE>
      <FPCLINE>    IF &lt;fs_lips&gt; IS ASSIGNED.</FPCLINE>
      <FPCLINE>      wa3-lgort = &lt;fs_lips&gt;-lgort.</FPCLINE>
      <FPCLINE>    ENDIF.</FPCLINE>
      <FPCLINE>  ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  READ TABLE lt_PICPS ASSIGNING FIELD-SYMBOL(&lt;fs_picps&gt;) WITH KEY matnr = wa3-matnr.</FPCLINE>
      <FPCLINE>  IF sy-subrc = 0.</FPCLINE>
      <FPCLINE>    READ TABLE lt_PICPS1 ASSIGNING FIELD-SYMBOL(&lt;fs_picps1&gt;) WITH KEY pickey = &lt;fs_picps&gt;-pickey.</FPCLINE>
      <FPCLINE>    IF sy-subrc = 0.</FPCLINE>
      <FPCLINE>      IF &lt;fs_picps1&gt; IS ASSIGNED.</FPCLINE>
      <FPCLINE>        wa3-matnr1 = &lt;fs_picps1&gt;-matnr.</FPCLINE>
      <FPCLINE>      ENDIF.</FPCLINE>
      <FPCLINE>    ENDIF.</FPCLINE>
      <FPCLINE>  ENDIF.</FPCLINE>
      <FPCLINE>  LOOP AT lt_quan INTO DATA(wa6) WHERE lgnum = wa3-lgnum AND matid = wa3-matid.</FPCLINE>
      <FPCLINE>    wa3-quan = wa3-quan + wa6-quan.</FPCLINE>
      <FPCLINE>    CLEAR :  wa6.</FPCLINE>
      <FPCLINE>  ENDLOOP.</FPCLINE>
      <FPCLINE>  MODIFY gt_final FROM wa3.</FPCLINE>
      <FPCLINE>  CLEAR  :wa3.</FPCLINE>
      <FPCLINE>ENDLOOP.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>SORT gt_final BY tanum.</FPCLINE>
      <FPCLINE>DATA(ls_vbeln1) = VALUE #( lt_vbeln[ 1 ] OPTIONAL ) .</FPCLINE>
      <FPCLINE>SELECT SINGLE vbeln,erdat,erzet,lfart,lprio,vsbed,bolnr,xabln FROM likp</FPCLINE>
      <FPCLINE>INTO @DATA(ls_likp) WHERE vbeln = @ls_vbeln1-vbeln.</FPCLINE>
      <FPCLINE>IF sy-subrc NE 0.</FPCLINE>
      <FPCLINE>*Manage Error</FPCLINE>
      <FPCLINE>  CLEAR gs_header.</FPCLINE>
      <FPCLINE>  RETURN.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>&quot;For Binning</FPCLINE>
      <FPCLINE>*BREAK-POINT.</FPCLINE>
      <FPCLINE>gs_header-vbeln = ls_likp-vbeln.   &quot;inbound delivery no</FPCLINE>
      <FPCLINE>gs_header-erdat = ls_likp-erdat.   &quot;Date</FPCLINE>
      <FPCLINE>gs_header-erzet = ls_likp-erzet.   &quot;Time</FPCLINE>
      <FPCLINE>IF ls_likp-bolnr IS NOT INITIAL.</FPCLINE>
      <FPCLINE>  gs_header-invoiceno =   ls_likp-bolnr. &quot; &amp;&amp; &apos;/&apos; &amp;&amp; ls_likp-xabln.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  IF ls_likp-xabln IS NOT INITIAL.</FPCLINE>
      <FPCLINE>    gs_header-invoiceno =   gs_header-invoiceno &amp;&amp; &apos;/&apos; &amp;&amp; ls_likp-xabln.</FPCLINE>
      <FPCLINE>  ENDIF.</FPCLINE>
      <FPCLINE>  CONDENSE gs_header-invoiceno.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE>IF lt_lips IS NOT INITIAL.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>*Reference Order Number and Receiving Plant</FPCLINE>
      <FPCLINE>  gs_header-vgbel = lt_lips[ 1 ]-vgbel.</FPCLINE>
      <FPCLINE>  DATA(lv_item) = lt_lips[ 1 ]-vgpos.</FPCLINE>
      <FPCLINE>  SELECT SINGLE</FPCLINE>
      <FPCLINE>         werks</FPCLINE>
      <FPCLINE>    FROM ekpo</FPCLINE>
      <FPCLINE>    INTO gs_header-werks</FPCLINE>
      <FPCLINE>   WHERE ebeln EQ gs_header-vgbel</FPCLINE>
      <FPCLINE>     AND ebelp EQ lv_item.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>*Supplying Plant</FPCLINE>
      <FPCLINE>  SELECT SINGLE</FPCLINE>
      <FPCLINE>         reswk</FPCLINE>
      <FPCLINE>    FROM ekko</FPCLINE>
      <FPCLINE>    INTO gs_header-reswk</FPCLINE>
      <FPCLINE>   WHERE ebeln EQ gs_header-vgbel</FPCLINE>
      <FPCLINE>           AND ( bsart = &apos;YSTO&apos; OR bsart = &apos;YSTB&apos; ).</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>DATA(lv_patner) = &apos;BP&apos; &amp;&amp; gs_header-werks .</FPCLINE>
      <FPCLINE>IF gs_header-werks IS NOT INITIAL.</FPCLINE>
      <FPCLINE>  SELECT SINGLE</FPCLINE>
      <FPCLINE>         name_org1</FPCLINE>
      <FPCLINE>    FROM but000</FPCLINE>
      <FPCLINE>    INTO gs_header-cust_name</FPCLINE>
      <FPCLINE>   WHERE partner EQ lv_patner.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
     </INITIALIZATION>
     <FORMS/>
