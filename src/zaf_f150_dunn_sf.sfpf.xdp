      <subform layout="tb" name="FIRST" w="175mm">
         <subform layout="tb" name="LetterBody" w="175mm" x="-0.0004mm" y="0.0001mm">
            <subform name="Dunning_Texts" w="175mm">
               <subform layout="lr-tb" name="Level1" presence="invisible" w="175mm" x="0mm" y="0mm">
                  <draw name="Level1Text" w="175mm" x="0mm" y="0mm">
                     <ui>
                        <textEdit/>
                     </ui>
                     <value>
                        <exData xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" contentType="text/html" maxLength="0" xft-xliff:id="N3413" xliff:rid="N3413">
                           <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="2.7.0.0"><p style="tab-interval:0.393in;tab-stops:left 1.377in">Dear Sir/Madam,</p><p style="tab-interval:0.393in;tab-stops:left 1.377in"><span style="xfa-spacerun:yes">  </span></p><p style="tab-interval:0.393in;tab-stops:left 1.377in">The invoices listed below are due for payment. If you have paid the amounts due in the intervening period, please disregard this letter.</p><p style="tab-interval:0.393in;tab-stops:left 1.377in"><span style="xfa-spacerun:yes">  </span></p><p style="tab-interval:0.393in;tab-stops:left 1.377in"><span style="xfa-spacerun:yes">  </span></p></body>
                        </exData>
                     </value>
                     <font typeface="Arial"/>
                     <margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/>
                     <assist>
                        <speak disable="1"/>
                     </assist>
                  </draw>
                  <?templateDesigner ScriptInitializers ready:form:runAt=server;?>
                  <event activity="ready" name="event__form_ready" ref="$form">
                     <script runAt="server">if ( $record.MHNK.MAHNS == "1" &amp; $record.MHNK.GMVDT.isNull ) then
	$.presence = "visible"
else
	$.presence = "hidden"
endif
</script>
                  </event>
                  <assist>
                     <speak disable="1"/>
                  </assist>
                  <?templateDesigner expand 1?></subform>
               <subform layout="tb" name="Level2" presence="invisible" w="175mm" x="0.0002mm" y="0mm">
                  <draw minH="32.2862mm" name="Level2Text" w="175mm" x="0mm" y="0.2686mm">
                     <ui>
                        <textEdit/>
                     </ui>
                     <value>
                        <exData xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" contentType="text/html" maxLength="0" xft-xliff:id="N3510" xliff:rid="N3510">
                           <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="2.7.0.0"><p style="tab-interval:0.393in;tab-stops:left 1.377in">Dear Sir/Madam,</p><p style="tab-interval:0.393in;tab-stops:left 1.377in"><span style="xfa-spacerun:yes">  </span></p><p style="tab-interval:0.393in;tab-stops:left 1.377in">We have already sent you a reminder about the due date of our invoices. We have, however, so far been unable to find any record of incoming payment for these invoices.</p><p style="tab-interval:0.393in;tab-stops:left 1.377in">Please transfer these overdue amounts immediately. If this dunning notice once again fails to elicit any action on your part, we will unfortunately have no option but to calculate interest on arrears.</p></body>
                        </exData>
                     </value>
                     <font typeface="Arial"/>
                     <margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/>
                     <assist>
                        <speak disable="1"/>
