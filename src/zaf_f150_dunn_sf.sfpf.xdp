                  <draw h="42.07mm" name="Level3Text" w="175mm">
                     <ui>
                        <textEdit/>
                     </ui>
                     <value>
                        <exData xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" contentType="text/html" maxLength="0" xft-xliff:id="N3891" xliff:rid="N3891">
                           <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="2.7.0.0"><p style="tab-interval:0.393in;tab-stops:left 1.377in">Dear Sir/Madam,</p><p style="tab-interval:0.393in;tab-stops:left 1.377in"><span style="xfa-spacerun:yes">  </span></p><p style="tab-interval:0.393in;tab-stops:left 1.377in">Since you have not reacted to our previous dunning notices, we have had to calculate interest on arrears to the amount of<span style="xfa-spacerun:yes">    </span><span xfa:embed="#floatingField003164" xfa:embedMode="raw" xfa:embedType="uri"/> %.<span style="xfa-spacerun:yes">   </span></p><p style="tab-interval:0.393in;tab-stops:left 1.377in">For the items due, as well as for the interest on arrears, we are now giving you a final payment period up until<span style="xfa-spacerun:yes">    </span><span xfa:embed="#floatingField008488" xfa:embedMode="raw" xfa:embedType="uri"/> . If you do not adhere to this payment deadline, we will unfortunately have to apply for a court order for our receivables to the amount of<span style="xfa-spacerun:yes">    </span><span xfa:embed="#floatingField005945" xfa:embedMode="raw" xfa:embedType="uri"/><span style="xfa-spacerun:yes">    </span><span xfa:embed="#floatingField018521" xfa:embedMode="raw" xfa:embedType="uri"/> .<span style="xfa-spacerun:yes">    </span></p></body>
                        </exData>
                     </value>
                     <font typeface="Arial"/>
                     <margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/>
                     <assist>
                        <speak disable="1"/>
                     </assist>
                  </draw>
                  <?templateDesigner ScriptInitializers ready:form:runAt=server;?>
                  <event activity="ready" name="event__form_ready" ref="$form">
                     <script runAt="server">if ( $record.MHNK.MAHNS == "3" &amp; $record.MHNK.GMVDT.isNull  ) then
	$.presence = "visible"
else
	$.presence = "hidden"
endif
</script>
                  </event>
                  <assist>
                     <speak disable="1"/>
                  </assist>
                  <?templateDesigner expand 1?></subform>
