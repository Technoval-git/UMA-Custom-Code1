                     <textEdit/>
                  </ui>
                  <value>
                     <exData contentType="text/html" xliff:rid="0E1EBA0F-DA04-497B-AB97-968D97F2D1E5">
                        <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="text-align:right;letter-spacing:0in">شركة التوكيلات العالمية للسيارات المحدودة</p></body>
                     </exData>
                  </value>
                  <font baselineShift="0pt" size="9pt" typeface="Myriad Pro"/>
                  <margin bottomInset="1mm" leftInset="1mm" rightInset="1mm" topInset="1mm"/>
