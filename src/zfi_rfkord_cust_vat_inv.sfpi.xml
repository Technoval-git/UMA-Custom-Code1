   <cls:CL_FP_CODING id="o5">
    <CL_FP_INTERFACE_DATA_CHANGED classVersion="1">
     <INTERFACE_DATA href="#o1"/>
    </CL_FP_INTERFACE_DATA_CHANGED>
    <CL_FP_CODING classVersion="1">
     <INPUT_PARAMETERS>
      <FPPARAMETER>GS_INTF</FPPARAMETER>
     </INPUT_PARAMETERS>
     <OUTPUT_PARAMETERS>
      <FPPARAMETER>GV_REASON_FOR_CR</FPPARAMETER>
      <FPPARAMETER>GV_INV_REF</FPPARAMETER>
      <FPPARAMETER>GV_E_REF</FPPARAMETER>
      <FPPARAMETER>GV_A_REF</FPPARAMETER>
      <FPPARAMETER>GV_A_NAME</FPPARAMETER>
      <FPPARAMETER>GV_E_NAME</FPPARAMETER>
      <FPPARAMETER>GV_HONGQI_LOGO</FPPARAMETER>
      <FPPARAMETER>GS_INTF</FPPARAMETER>
     </OUTPUT_PARAMETERS>
     <INITIALIZATION>
      <FPCLINE>DATA :</FPCLINE>
      <FPCLINE>  ls_intf_in TYPE zfi_credit_debit_note_in_s.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>ls_intf_in = VALUE #(</FPCLINE>
      <FPCLINE>                      ls_header   = ls_header</FPCLINE>
      <FPCLINE>                      lt_address  = lt_address</FPCLINE>
      <FPCLINE>                      lt_contact  = lt_contact</FPCLINE>
      <FPCLINE>                      lt_item     = lt_item</FPCLINE>
      <FPCLINE>                      lt_sum      = lt_sum</FPCLINE>
      <FPCLINE>                      lt_rtab     = lt_rtab</FPCLINE>
      <FPCLINE>                      lt_paymo    = lt_paymo</FPCLINE>
      <FPCLINE>                      lt_text     = lt_text</FPCLINE>
      <FPCLINE>                      lt_list     = lt_list</FPCLINE>
      <FPCLINE>                     ).</FPCLINE>
      <FPCLINE/>
      <FPCLINE>DATA(lo_obj) = NEW zcl_fi_001_cust_vat_inv( is_intf_in = ls_intf_in ).</FPCLINE>
      <FPCLINE/>
      <FPCLINE>lo_obj-&gt;m_init_form_processing(</FPCLINE>
      <FPCLINE>  EXPORTING</FPCLINE>
      <FPCLINE>    is_intf_in =  ls_intf_in                &quot; Credit Debit Note Input structure</FPCLINE>
      <FPCLINE>  IMPORTING</FPCLINE>
      <FPCLINE>    es_intf    = gs_intf</FPCLINE>
      <FPCLINE>).</FPCLINE>
      <FPCLINE/>
      <FPCLINE>* QR CODE</FPCLINE>
      <FPCLINE>CASE gs_intf-header-doc_typ.</FPCLINE>
      <FPCLINE>  WHEN &apos;KR&apos; OR &apos;KG&apos;.</FPCLINE>
      <FPCLINE>    CLEAR: gs_intf-general-qr_code.</FPCLINE>
      <FPCLINE>ENDCASE.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>* Title</FPCLINE>
      <FPCLINE>CASE gs_intf-header-doc_typ.</FPCLINE>
      <FPCLINE>  WHEN &apos;DR&apos;.</FPCLINE>
      <FPCLINE>    gv_title = &apos;Tax Invoices&apos;.</FPCLINE>
      <FPCLINE>    gv_arabic_title = &apos;فاتورة ضريبية&apos;.</FPCLINE>
      <FPCLINE>*    gv_e_ref = &apos;Customer Ref&apos;.</FPCLINE>
      <FPCLINE>*    gv_a_ref = &apos;رقم العميل&apos;.</FPCLINE>
      <FPCLINE>     gv_e_ref = &apos;Customer No&apos;.</FPCLINE>
      <FPCLINE>    gv_a_ref = &apos;رقم العميل&apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>    gv_e_name = &apos;Customer Name&apos;.</FPCLINE>
      <FPCLINE>    gv_a_name =  &apos;اسم العميل&apos;.</FPCLINE>
      <FPCLINE>  WHEN &apos;DG&apos;.</FPCLINE>
      <FPCLINE>    gv_title = &apos;Credit Note&apos;.</FPCLINE>
      <FPCLINE>    gv_arabic_title =  &apos;اشعار دائن&apos;.</FPCLINE>
      <FPCLINE>*     gv_e_ref = &apos;Customer Ref&apos;.</FPCLINE>
      <FPCLINE>*    gv_a_ref = &apos;رقم العميل&apos;.</FPCLINE>
      <FPCLINE>     gv_e_ref = &apos;Customer No&apos;.</FPCLINE>
      <FPCLINE>    gv_a_ref = &apos;رقم العميل&apos;.</FPCLINE>
      <FPCLINE>    gv_e_name = &apos;Customer Name&apos;.</FPCLINE>
      <FPCLINE>    gv_a_name =  &apos;اسم العميل&apos;.</FPCLINE>
      <FPCLINE>  WHEN &apos;KR&apos;.</FPCLINE>
      <FPCLINE>    gv_title = &apos;Tax Invoices&apos;.</FPCLINE>
      <FPCLINE>    gv_arabic_title =  &apos;فاتورة ضريبية&apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>     gv_e_ref = &apos;Vendor Ref&apos;.</FPCLINE>
      <FPCLINE>    gv_a_ref =  &apos; مورد رقم&apos;.</FPCLINE>
      <FPCLINE>    gv_e_name = &apos;Vendor Name&apos;.</FPCLINE>
      <FPCLINE>    gv_A_name =  &apos;اسم مورد&apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE/>
      <FPCLINE>  WHEN &apos;KG&apos;.</FPCLINE>
      <FPCLINE>    gv_title = &apos;Debit Note&apos;.</FPCLINE>
      <FPCLINE>    gv_arabic_title =  &apos;اشعار مدين&apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>    gv_e_ref = &apos;Vendor Ref&apos;.</FPCLINE>
      <FPCLINE>    gv_a_ref =  &apos; مورد رقم&apos;.</FPCLINE>
      <FPCLINE>    gv_e_name = &apos;Vendor Name&apos;.</FPCLINE>
      <FPCLINE>    gv_a_name =  &apos;اسم مورد&apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  when &apos;KD&apos;.</FPCLINE>
      <FPCLINE>       gv_title = &apos;Credit Note&apos;.</FPCLINE>
      <FPCLINE>    gv_arabic_title = &apos;اشعار دائن&apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>    gv_e_ref = &apos;Vendor Ref&apos;.</FPCLINE>
      <FPCLINE>    gv_a_ref =  &apos; مورد رقم&apos;.</FPCLINE>
      <FPCLINE>    gv_e_name = &apos;Vendor Name&apos;.</FPCLINE>
      <FPCLINE>    gv_a_name =  &apos;اسم مورد&apos;.</FPCLINE>
      <FPCLINE>  when &apos;DD&apos;.</FPCLINE>
      <FPCLINE>   gv_title = &apos;Debit Note&apos;.</FPCLINE>
      <FPCLINE>    gv_arabic_title =  &apos;اشعار مدين&apos;.</FPCLINE>
      <FPCLINE>*    gv_e_ref = &apos;Customer Ref&apos;.</FPCLINE>
      <FPCLINE>    gv_e_ref = &apos;Customer No&apos;.</FPCLINE>
      <FPCLINE>*    gv_a_ref = &apos;رقم العميل&apos;.</FPCLINE>
      <FPCLINE>    gv_a_ref = &apos;رقم العميل &apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>    gv_e_name = &apos;Customer Name&apos;.</FPCLINE>
      <FPCLINE>    gv_a_name =  &apos;اسم العميل&apos;.</FPCLINE>
      <FPCLINE> ENDCASE.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>* Date and Time</FPCLINE>
      <FPCLINE>DATA(lv_date) = |{ gs_intf-header-invoice_dt+6(2) }| &amp;&amp; &apos;/&apos; &amp;&amp;</FPCLINE>
      <FPCLINE>                |{ gs_intf-header-invoice_dt+4(2) }| &amp;&amp; &apos;/&apos; &amp;&amp;</FPCLINE>
      <FPCLINE>                |{ gs_intf-header-invoice_dt+0(4) }|.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>DATA(lv_time) = |{ gs_intf-header-invoice_tm+0(2) }| &amp;&amp; &apos;:&apos; &amp;&amp;</FPCLINE>
      <FPCLINE>                |{ gs_intf-header-invoice_tm+2(2) }| &amp;&amp; &apos;:&apos; &amp;&amp;</FPCLINE>
      <FPCLINE>                |{ gs_intf-header-invoice_tm+4(2) }|.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>*CONCATENATE lv_date lv_time INTO gv_date_time SEPARATED BY space.</FPCLINE>
      <FPCLINE>gv_date_time = lv_date.</FPCLINE>
      <FPCLINE/>
      <FPCLINE/>
      <FPCLINE>&quot; Seller&apos;s CR Number</FPCLINE>
      <FPCLINE>SELECT SINGLE *</FPCLINE>
      <FPCLINE>  FROM t001z</FPCLINE>
      <FPCLINE>  INTO @DATA(ls_t001z)</FPCLINE>
      <FPCLINE>  WHERE bukrs EQ @gs_intf-header-bukrs</FPCLINE>
      <FPCLINE>    AND party EQ &apos;CREGNO&apos;.</FPCLINE>
      <FPCLINE>IF sy-subrc EQ 0.</FPCLINE>
      <FPCLINE>  gv_slr_cr_no = ls_t001z-paval.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>&quot; Customer CR No</FPCLINE>
      <FPCLINE>SELECT SINGLE *</FPCLINE>
      <FPCLINE>  FROM but0id</FPCLINE>
      <FPCLINE>  INTO @DATA(ls_but0id)</FPCLINE>
      <FPCLINE>  WHERE partner EQ @gs_intf-header-kunnr</FPCLINE>
      <FPCLINE>    AND type EQ &apos;BUP002&apos;.</FPCLINE>
      <FPCLINE>IF sy-subrc EQ 0.</FPCLINE>
      <FPCLINE>  gv_cst_cr_no = ls_but0id-idnumber.</FPCLINE>
      <FPCLINE>*  CONCATENATE ls_but0id-idnumber ls_but0id-</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>select SINGLE bktxt from bkpf into gv_reason_for_cr   &quot;gv_inv_ref</FPCLINE>
      <FPCLINE>  WHERE  BUKRS = gs_intf-header-bukrs and</FPCLINE>
      <FPCLINE>         belnr = gs_intf-header-belnr and</FPCLINE>
      <FPCLINE>         gjahr =  gs_intf-header-gjahr.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  data: lv_rebzg type rebzg,</FPCLINE>
      <FPCLINE>       lv_rebzj type rebzj,</FPCLINE>
      <FPCLINE>       lv_rebzz type rebzz.</FPCLINE>
      <FPCLINE>select SINGLE rebzg rebzj rebzz from bseg into ( lv_rebzg , lv_rebzj, lv_rebzz )</FPCLINE>
      <FPCLINE>  WHERE  BUKRS = gs_intf-header-bukrs and</FPCLINE>
      <FPCLINE>         belnr = gs_intf-header-belnr and</FPCLINE>
      <FPCLINE>         gjahr =  gs_intf-header-gjahr and koart = &apos;D&apos;.</FPCLINE>
      <FPCLINE>  if sy-subrc = 0.</FPCLINE>
      <FPCLINE>    CONCATENATE lv_rebzg lv_rebzj lv_rebzz into gv_inv_ref  SEPARATED BY space.</FPCLINE>
      <FPCLINE>*    gv_reason_for_cr SEPARATED BY space.</FPCLINE>
      <FPCLINE>  endif.</FPCLINE>
      <FPCLINE>*****    CLEAR gv_image_footer.</FPCLINE>
      <FPCLINE>*****    CALL METHOD cl_ssf_xsf_utilities=&gt;get_bds_graphic_as_bmp</FPCLINE>
      <FPCLINE>*****      EXPORTING</FPCLINE>
      <FPCLINE>*****        p_object       = &apos;GRAPHICS&apos;</FPCLINE>
      <FPCLINE>*****        p_name         = &apos;HONGQI_LOGO&apos;</FPCLINE>
      <FPCLINE>*****        p_id           = &apos;BMAP&apos;</FPCLINE>
      <FPCLINE>*****        p_btype        = &apos;BCOL&apos;</FPCLINE>
      <FPCLINE>*****      RECEIVING</FPCLINE>
      <FPCLINE>*****        p_bmp          = gv_hongqi_logo</FPCLINE>
      <FPCLINE>*****      EXCEPTIONS</FPCLINE>
      <FPCLINE>*****        not_found      = 1</FPCLINE>
      <FPCLINE>*****        internal_error = 2</FPCLINE>
      <FPCLINE>*****        OTHERS         = 3.</FPCLINE>
      <FPCLINE>*****    IF sy-subrc &lt;&gt; 0.</FPCLINE>
      <FPCLINE>****** Implement suitable error handling here</FPCLINE>
      <FPCLINE>*****    ENDIF.</FPCLINE>
     </INITIALIZATION>
     <FORMS/>
    </CL_FP_CODING>
