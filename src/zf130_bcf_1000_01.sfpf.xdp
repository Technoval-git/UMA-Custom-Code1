            <draw name="BalanceInquiriesReminder" w="6.899806in">
               <ui>
                  <textEdit/>
               </ui>
               <value>
                  <exData xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" contentType="text/html" maxLength="0" xft-xliff:id="N7689" xliff:rid="N7689">
                     <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="2.7.0.0"><p style="font-weight:bold">2 Balance inquiry from<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField018716" xfa:embedMode="raw" xfa:embedType="uri"/></p><p><span style="xfa-spacerun:yes"> </span></p><p><span style="xfa-spacerun:yes"> </span></p><p>Dear Sir/Madam,<span style="xfa-spacerun:yes"> </span></p><p><span style="xfa-spacerun:yes"> </span></p><p>As we have not received a reply to our confirmation attempt from<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField019718" xfa:embedMode="raw" xfa:embedType="uri"/> to date, we would like to ask you again to list and confirm the balance of our open posts for<span style="xfa-spacerun:yes">  </span><span xfa:embed="#floatingField019895" xfa:embedMode="raw" xfa:embedType="uri"/> on the last page of this letter. If possible, please enclose a list of open items on the reconciliation key date in your answer.</p><p><span style="xfa-spacerun:yes"> </span></p><p>Please use the enclosed franked envelope for your reply including a list of open items. We would be very grateful if you send us your reply by<span style="xfa-spacerun:yes">  </span><span xfa:embed="#floatingField005447" xfa:embedMode="raw" xfa:embedType="uri"/>.</p><p><span style="xfa-spacerun:yes"> </span></p><p>If you have sent a reply in the meantime, please ignore this letter.</p><p><span style="xfa-spacerun:yes"> </span></p><p>We thank you in advance for doing so as soon as possible.</p></body>
                  </exData>
               </value>
               <font typeface="Arial"/>
               <margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/>
               <para vAlign="middle"/>
               <assist>
                  <speak disable="1"/>
               </assist>
            </draw>
            <event activity="ready" name="event__form_ready" ref="$form">
               <script>$.BalanceConfirmation.presence = "hidden"
$.BalanceNotifications.presence = "hidden"
$.BalanceInquiries.presence = "hidden"
$.BalanceConfirmationReminder.presence = "hidden"
$.BalanceInquiriesReminder.presence = "hidden"

if ($.CORRID.rawValue == "BCI") then
  $.BalanceConfirmation.presence = "visible"
elseif ($.CORRID.rawValue == "BNO") then
  $.BalanceNotifications.presence = "visible"
elseif ($.CORRID.rawValue == "BIN") then
  $.BalanceInquiries.presence = "visible"
elseif ($.CORRID.rawValue == "BCR") then
  $.BalanceConfirmationReminder.presence = "visible"
elseif ($.CORRID.rawValue == "BIR") then
  $.BalanceInquiriesReminder.presence = "visible"
endif
</script>
            </event>
            <draw h="0.805556in" name="Signature" w="6.889764in">
               <ui>
                  <textEdit/>
               </ui>
               <value>
                  <exData xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" contentType="text/html" maxLength="0" xft-xliff:id="N7813" xliff:rid="N7813">
                     <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="2.7.0.0"><p><span style="xfa-spacerun:yes"> </span></p><p><span style="xfa-spacerun:yes"> </span></p><p>Yours sincerely,</p><p><span style="xfa-spacerun:yes"> </span></p><p>IDES Holding AG</p></body>
                  </exData>
               </value>
               <font typeface="Arial"/>
               <margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/>
               <para vAlign="middle"/>
               <assist>
                  <speak disable="1"/>
               </assist>
               <?renderCache.bounds 496063 58000 0 0 0 0 0 0?>
               <?renderCache.textRun 2    0 0 7896 0 0 0 "Arial" 0 0 10000 ISO-8859-1?>
               <?renderCache.textRun 2    0 0 19896 0 0 0 "Arial" 0 0 10000 ISO-8859-1?>
               <?renderCache.textRun 17 Yours sincerely,  0 0 31896 0 0 0 "Arial" 0 0 10000 ISO-8859-1?>
               <?renderCache.textRun 2    0 0 43896 0 0 0 "Arial" 0 0 10000 ISO-8859-1?>
               <?renderCache.textRun 15 IDES Holding AG 0 0 55896 0 0 0 "Arial" 0 0 10000 ISO-8859-1?></draw>
            <?templateDesigner expand 0?></subform>
