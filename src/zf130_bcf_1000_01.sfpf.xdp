            <draw name="BalanceInquiries" w="6.899806in">
               <ui>
                  <textEdit/>
               </ui>
               <value>
                  <exData xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" contentType="text/html" maxLength="0" xft-xliff:id="N6864" xliff:rid="N6864">
                     <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="2.7.0.0"><p style="font-weight:bold">Balance inquiry from<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField005436" xfa:embedMode="raw" xfa:embedType="uri"/></p><p><span style="xfa-spacerun:yes"> </span></p><p><span style="xfa-spacerun:yes"> </span></p><p>Dear Sir/Madam,<span style="xfa-spacerun:yes"> </span></p><p><span style="xfa-spacerun:yes"> </span></p><p>As part of the audit of our end of year closing, we kindly ask you to list and confirm the balance of our open items for<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField014604" xfa:embedMode="raw" xfa:embedType="uri"/> on the last page of this letter. If possible, please enclose a list of open items on the reconciliation key date in your answer.</p><p><span style="xfa-spacerun:yes"> </span></p><p>Please use the enclosed franked envelope for your reply including a list of open items. We would be very grateful if you send us your reply by<span style="xfa-spacerun:yes">  </span><span xfa:embed="#floatingField003902" xfa:embedMode="raw" xfa:embedType="uri"/>.</p><p><span style="xfa-spacerun:yes"> </span></p><p>We thank you in advance for doing so as soon as possible.<span style="xfa-spacerun:yes"> </span></p></body>
                  </exData>
               </value>
               <font typeface="Arial"/>
               <margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/>
               <para vAlign="middle"/>
               <assist>
                  <speak disable="1"/>
               </assist>
            </draw>
            <field access="readOnly" h="9mm" id="floatingField000153" name="ABSTIDAT07" presence="hidden" w="62mm" x="0mm" y="0mm">
               <ui>
                  <dateTimeEdit>
                     <border>
                        <?templateDesigner StyleID aped3?>
                        <edge stroke="lowered"/>
                     </border>
                     <margin/>
                  </dateTimeEdit>
               </ui>
               <font typeface="Arial"/>
               <margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/>
               <para vAlign="middle"/>
               <value>
                  <date/>
               </value>
               <desc>
                  <text xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" name="Schema-Anmerkung" xft-xliff:id="N4360">Abstimmungsstichtag der Salden</text>
