                           <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="2.7.0.0"><p style="text-align:right;font-family:'Times New Roman';letter-spacing:0in"><span style="xfa-spacerun:yes"> </span><span style="xfa-tab-count:1">         </span><span style="xfa-spacerun:yes">                                                                  </span><span style="font-weight:bold"><span style="xfa-spacerun:yes">  </span></span><span style="font-family:'Myriad Pro';font-size:11pt;font-weight:bold">معلومات البائع</span><span style="font-family:Calibri;font-size:11pt;font-weight:bold"><span style="xfa-tab-count:1">         </span><br/></span><span style="font-family:'Myriad Pro';font-size:11pt"> <span style="xfa-spacerun:yes">        </span></span><span style="font-family:Calibri;font-size:11pt"><span style="xfa-tab-count:1">         </span><span style="xfa-spacerun:yes">                                           </span></span><span style="font-family:'Myriad Pro';font-size:11pt"> التوكيلات العالمية للسيارات المحدودة</span><span style="font-family:Calibri;font-size:11pt"><span style="xfa-spacerun:yes">  </span><br/><span style="xfa-tab-count:1">         </span></span><span style="font-family:'Myriad Pro';font-size:11pt">العنوان<span style="xfa-spacerun:yes"> </span></span><span style="font-family:Calibri;font-size:11pt">:</span><span style="font-family:'Myriad Pro';font-size:11pt"> شارع فلسطين، الحمراء، جدة، المملكة العربية السعودية<span style="xfa-spacerun:yes"> </span></span><span style="font-family:Calibri;font-size:11pt"><span style="xfa-spacerun:yes">          </span></span></p><p style="text-align:right;font-family:Calibri;font-size:11pt;letter-spacing:0in"><span style="xfa-spacerun:yes">                                              </span><span style="font-family:'Myriad Pro'">السجل التجاري</span> : 4030120719 <span style="xfa-tab-count:1">         </span><span style="xfa-spacerun:yes">       </span><br/><span style="font-family:'Myriad Pro'">الرقم الضريبي<span style="xfa-spacerun:yes"> </span></span>: 300203568900003 <span style="xfa-tab-count:1">         </span><br/><span style="font-family:'Myriad Pro'">رقم التعريف الضريبي :<span style="xfa-spacerun:yes"> </span></span>3002035689 <span style="xfa-tab-count:1">         </span><br/><br/></p></body>
                        </exData>
                     </value>
                     <font baselineShift="0pt" typeface="Arial"/>
                     <margin bottomInset="0.5mm" leftInset="0.5mm" rightInset="0.5mm" topInset="0.5mm"/>
