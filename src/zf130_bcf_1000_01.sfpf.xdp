            <draw name="BalanceConfirmationReminder" w="6.899806in">
               <ui>
                  <textEdit/>
               </ui>
               <value>
                  <exData xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" contentType="text/html" maxLength="0" xft-xliff:id="N7277" xliff:rid="N7277">
                     <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="2.7.0.0"><p style="font-weight:bold">2 Balance confirmation for  .<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField000153" xfa:embedMode="raw" xfa:embedType="uri"/></p><p><span style="xfa-spacerun:yes"> </span></p><p><span style="xfa-spacerun:yes"> </span></p><p>Dear Sir/Madam,</p><p><span style="xfa-spacerun:yes"> </span></p><p>As we have not received a reply to our confirmation attempt from<span style="xfa-spacerun:yes">  </span><span xfa:embed="#floatingField000292" xfa:embedMode="raw" xfa:embedType="uri"/> to date, we would like to ask you again to compare the open items listed for<span style="xfa-spacerun:yes">  </span><span xfa:embed="#floatingField012382" xfa:embedMode="raw" xfa:embedType="uri"/> with your books in the itemization and confirm the agreement of the balance on the last page of this letter by<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField017421" xfa:embedMode="raw" xfa:embedType="uri"/>. If differences are found after the audit please advice us of this, so that the causes of the differences can be determined.</p><p><span style="xfa-spacerun:yes"> </span></p><p>Please use the enclosed franked envelope for your reply and include an explanation of the differences.</p><p><span style="xfa-spacerun:yes"> </span></p><p>If you have sent a reply in the meantime, please ignore this letter.</p><p><span style="xfa-spacerun:yes"> </span></p><p>We thank you in advance for doing so as soon as possible.</p></body>
                  </exData>
               </value>
               <font typeface="Arial"/>
               <margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/>
               <para vAlign="middle"/>
               <assist>
                  <speak disable="1"/>
               </assist>
            </draw>
            <field access="readOnly" h="9mm" id="floatingField018716" name="ABSTIDAT09" presence="hidden" w="62mm" x="0mm" y="0mm">
               <ui>
                  <dateTimeEdit>
                     <border>
