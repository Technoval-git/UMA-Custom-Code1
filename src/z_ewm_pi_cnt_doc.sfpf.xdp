<xfa:datasets xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/">
   <xfa:data xfa:dataNode="dataGroup"/>
   <dd:dataDescription xmlns:dd="http://ns.adobe.com/data-description/" dd:name="data">
      <data>
         <DATE/>
         <IT_PI_ITEM dd:minOccur="0">
            <DATA dd:maxOccur="-1">
               <LGNUM/>
               <LGNUM_TXT/>
               <COUNT_ITEM_HEAD dd:minOccur="0">
                  <DATA dd:maxOccur="-1">
                     <AAREA/>
                     <AAREA_TXT/>
                     <PRIORITY/>
                     <IND_PRINTED/>
                     <DOC_TYPE/>
                     <DOC_TYPE_TXT/>
                     <DOC_STATUS_TXT/>
                     <REASON/>
                     <WHO dd:minOccur="0" dd:nullType="exclude"/>
                     <COUNT_DATE_UI/>
                     <LGPLA/>
                     <COUNT_ITEM dd:minOccur="0">
                        <DATA dd:maxOccur="-1">
                           <LVL/>
                           <TYPE_ITEM/>
                           <HUIDENT dd:minOccur="0" dd:nullType="exclude"/>
                           <HUIDENT_ITEM dd:minOccur="0" dd:nullType="exclude"/>
                           <QUANTITY_B dd:minOccur="0" dd:nullType="exclude"/>
                           <UNIT_B dd:minOccur="0" dd:nullType="exclude"/>
                           <CWQUAN dd:minOccur="0" dd:nullType="exclude"/>
                           <CWUNIT dd:minOccur="0" dd:nullType="exclude"/>
                           <MATNR/>
                           <MAKTX/>
                           <CHARG/>
                           <CAT/>
                           <ENTITLED/>
                           <OWNER/>
                           <STOCK_DOCCAT dd:minOccur="0" dd:nullType="exclude"/>
                           <STOCK_DOCCAT_TEXT/>
                           <STOCK_DOCNO dd:minOccur="0" dd:nullType="exclude"/>
                           <STOCK_ITMNO dd:minOccur="0" dd:nullType="exclude"/>
                           <SER_STOCK/>
                           <UI_WDATU/>
                           <COO/>
                           <QDOCCAT/>
                           <QDOCCAT_TEXT/>
                           <QDOCNO dd:minOccur="0" dd:nullType="exclude"/>
                           <QITEMNO dd:minOccur="0" dd:nullType="exclude"/>
                           <HAZMAT/>
                           <SERID_T dd:minOccur="0">
                              <DATA dd:maxOccur="-1">
                                 <SERID/>
                                 <UII/>
                              </DATA>
                           </SERID_T>
                           <HU_PMAT/>
                           <HU_TYPE/>
                        </DATA>
                     </COUNT_ITEM>
                     <ALLOW_COUNT_REFERENCE/>
                  </DATA>
               </COUNT_ITEM_HEAD>
            </DATA>
         </IT_PI_ITEM>
      </data>
   </dd:dataDescription>
</xfa:datasets>
