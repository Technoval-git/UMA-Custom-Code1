<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xfa="http://www.xfa.org/schema/xfa-template/2.2/" xmlns:xfadata="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xhtml="http://www.w3.org/1999/xhtml" attributeFormDefault="unqualified" elementFormDefault="qualified" id="XFASchemaXSD">
   <xsd:import namespace="http://www.xfa.org/schema/xfa-data/1.0/"/>
   <xsd:element name="data">
      <xsd:complexType>
         <xsd:sequence>
            <xsd:element name="DATE" type="xsd:date">
               <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                  <xsd:documentation>System Date</xsd:documentation>
                  <xsd:appinfo>
                     <dc:description>System Date</dc:description>
                     <dc:title>Date</dc:title>
                  </xsd:appinfo>
               </xsd:annotation>
            </xsd:element>
            <xsd:element maxOccurs="1" minOccurs="0" name="IT_PI_ITEM">
               <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                  <xsd:documentation>Print Physical Inventory Document Items with Adobe</xsd:documentation>
                  <xsd:appinfo>
                     <dc:description>Print Physical Inventory Document Items with Adobe</dc:description>
                  </xsd:appinfo>
               </xsd:annotation>
               <xsd:complexType>
                  <xsd:sequence>
                     <xsd:element maxOccurs="unbounded" minOccurs="1" name="DATA">
                        <xsd:complexType>
                           <xsd:sequence>
                              <xsd:element name="LGNUM">
                                 <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                    <xsd:documentation>Warehouse Number/Warehouse Complex</xsd:documentation>
                                    <xsd:appinfo>
                                       <dc:description>Warehouse Number/Warehouse Complex</dc:description>
                                       <dc:title>WhN</dc:title>
                                    </xsd:appinfo>
                                 </xsd:annotation>
                                 <xsd:simpleType>
                                    <xsd:restriction base="xsd:string">
                                       <xsd:maxLength value="4"/>
                                    </xsd:restriction>
                                 </xsd:simpleType>
                              </xsd:element>
                              <xsd:element name="LGNUM_TXT">
                                 <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                    <xsd:documentation>Description</xsd:documentation>
                                    <xsd:appinfo>
                                       <dc:description>Description</dc:description>
                                       <dc:title>Description</dc:title>
                                    </xsd:appinfo>
                                 </xsd:annotation>
                                 <xsd:simpleType>
                                    <xsd:restriction base="xsd:string">
                                       <xsd:maxLength value="40"/>
                                    </xsd:restriction>
                                 </xsd:simpleType>
                              </xsd:element>
                              <xsd:element maxOccurs="1" minOccurs="0" name="COUNT_ITEM_HEAD">
                                 <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                    <xsd:documentation>Print Physical Inventory Document Header with Adobe</xsd:documentation>
                                    <xsd:appinfo>
                                       <dc:description>Print Physical Inventory Document Header with Adobe</dc:description>
                                    </xsd:appinfo>
                                 </xsd:annotation>
                                 <xsd:complexType>
                                    <xsd:sequence>
                                       <xsd:element maxOccurs="unbounded" minOccurs="1" name="DATA">
                                          <xsd:complexType>
                                             <xsd:sequence>
                                                <xsd:element name="AAREA">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Activity Area</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Activity Area</dc:description>
                                                         <dc:title>Activity Area</dc:title>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                   <xsd:simpleType>
                                                      <xsd:restriction base="xsd:string">
                                                         <xsd:maxLength value="4"/>
                                                      </xsd:restriction>
                                                   </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="AAREA_TXT">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Description</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Description</dc:description>
                                                         <dc:title>Description</dc:title>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                   <xsd:simpleType>
                                                      <xsd:restriction base="xsd:string">
                                                         <xsd:maxLength value="40"/>
                                                      </xsd:restriction>
                                                   </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="PRIORITY">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Priority of Physical Inventory</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Priority of Physical Inventory</dc:description>
                                                         <dc:title>Phys. Inv. Priority</dc:title>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                   <xsd:simpleType>
                                                      <xsd:restriction base="xsd:string">
                                                         <xsd:maxLength value="1"/>
                                                         <xsd:pattern value="\d+"/>
                                                      </xsd:restriction>
                                                   </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="IND_PRINTED">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Status: Physical Inventory Document Item Already Printed Out</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Status: Physical Inventory Document Item Already Printed Out</dc:description>
                                                         <dc:title>Print</dc:title>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                   <xsd:simpleType>
                                                      <xsd:restriction base="xsd:string">
                                                         <xsd:maxLength value="1"/>
                                                      </xsd:restriction>
                                                   </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="DOC_TYPE">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Physical Inventory Procedure (Document Type of Phys. Inv.)</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Physical Inventory Procedure (Document Type of Phys. Inv.)</dc:description>
                                                         <dc:title>Physical Inventory Procedure</dc:title>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                   <xsd:simpleType>
                                                      <xsd:restriction base="xsd:string">
                                                         <xsd:maxLength value="2"/>
                                                      </xsd:restriction>
                                                   </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="DOC_TYPE_TXT">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Physical Inventory Procedure Description</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Physical Inventory Procedure Description</dc:description>
                                                         <dc:title>Physical Inventory Procedure Description</dc:title>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                   <xsd:simpleType>
                                                      <xsd:restriction base="xsd:string">
                                                         <xsd:maxLength value="50"/>
                                                      </xsd:restriction>
                                                   </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="DOC_STATUS_TXT">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Description of Physical Inventory Status</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Description of Physical Inventory Status</dc:description>
                                                         <dc:title>Status of Phys. Inv. Progress</dc:title>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                   <xsd:simpleType>
                                                      <xsd:restriction base="xsd:string">
                                                         <xsd:maxLength value="50"/>
                                                      </xsd:restriction>
                                                   </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="REASON">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Reason for Physical Inventory/Inventory Difference</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Reason for Physical Inventory/Inventory Difference</dc:description>
                                                         <dc:title>Reason for Physical Inventory</dc:title>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                   <xsd:simpleType>
                                                      <xsd:restriction base="xsd:string">
                                                         <xsd:maxLength value="4"/>
                                                      </xsd:restriction>
                                                   </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element maxOccurs="1" minOccurs="0" name="WHO">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Warehouse Order Number</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Warehouse Order Number</dc:description>
                                                         <dc:title>Whse Order</dc:title>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                   <xsd:simpleType>
                                                      <xsd:restriction base="xsd:string">
                                                         <xsd:maxLength value="10"/>
                                                         <xsd:pattern value="\d+"/>
                                                      </xsd:restriction>
                                                   </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="COUNT_DATE_UI" type="xsd:date">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Date of Physical Inventory Count</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Date of Physical Inventory Count</dc:description>
                                                         <dc:title>Count Date</dc:title>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                </xsd:element>
                                                <xsd:element name="LGPLA">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Storage Bin</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Storage Bin</dc:description>
                                                         <dc:title>Bin</dc:title>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                   <xsd:simpleType>
                                                      <xsd:restriction base="xsd:string">
                                                         <xsd:maxLength value="18"/>
                                                      </xsd:restriction>
                                                   </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element maxOccurs="1" minOccurs="0" name="COUNT_ITEM">
                                                   <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                      <xsd:documentation>Print Physical Inventory Document Items with Adobe</xsd:documentation>
                                                      <xsd:appinfo>
                                                         <dc:description>Print Physical Inventory Document Items with Adobe</dc:description>
                                                      </xsd:appinfo>
                                                   </xsd:annotation>
                                                   <xsd:complexType>
                                                      <xsd:sequence>
                                                         <xsd:element maxOccurs="unbounded" minOccurs="1" name="DATA">
                                                            <xsd:complexType>
                                                               <xsd:sequence>
                                                                  <xsd:element name="LVL">
                                                                     <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                                        <xsd:documentation>Level of Stock Hierarchy</xsd:documentation>
                                                                        <xsd:appinfo>
                                                                           <dc:description>Level of Stock Hierarchy</dc:description>
                                                                           <dc:title>Level</dc:title>
                                                                        </xsd:appinfo>
                                                                     </xsd:annotation>
                                                                     <xsd:simpleType>
                                                                        <xsd:restriction base="xsd:int">
                                                                           <xsd:totalDigits value="10"/>
                                                                        </xsd:restriction>
                                                                     </xsd:simpleType>
                                                                  </xsd:element>
                                                                  <xsd:element name="TYPE_ITEM">
                                                                     <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                                        <xsd:documentation>Physical Inventory Item Category (Product/HU)</xsd:documentation>
                                                                        <xsd:appinfo>
                                                                           <dc:description>Physical Inventory Item Category (Product/HU)</dc:description>
                                                                           <dc:title>ItemCat</dc:title>
                                                                        </xsd:appinfo>
                                                                     </xsd:annotation>
                                                                     <xsd:simpleType>
                                                                        <xsd:restriction base="xsd:string">
                                                                           <xsd:maxLength value="1"/>
                                                                        </xsd:restriction>
                                                                     </xsd:simpleType>
                                                                  </xsd:element>
                                                                  <xsd:element maxOccurs="1" minOccurs="0" name="HUIDENT">
                                                                     <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                                        <xsd:documentation>Handling Unit Identification</xsd:documentation>
                                                                        <xsd:appinfo>
                                                                           <dc:description>Handling Unit Identification</dc:description>
                                                                           <dc:title>Handling Unit</dc:title>
                                                                        </xsd:appinfo>
                                                                     </xsd:annotation>
                                                                     <xsd:simpleType>
                                                                        <xsd:restriction base="xsd:string">
                                                                           <xsd:maxLength value="20"/>
                                                                        </xsd:restriction>
                                                                     </xsd:simpleType>
                                                                  </xsd:element>
                                                                  <xsd:element maxOccurs="1" minOccurs="0" name="HUIDENT_ITEM">
                                                                     <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                                        <xsd:documentation>Handling Unit Identification</xsd:documentation>
                                                                        <xsd:appinfo>
                                                                           <dc:description>Handling Unit Identification</dc:description>
                                                                           <dc:title>Handling Unit</dc:title>
                                                                        </xsd:appinfo>
                                                                     </xsd:annotation>
                                                                     <xsd:simpleType>
                                                                        <xsd:restriction base="xsd:string">
                                                                           <xsd:maxLength value="20"/>
                                                                        </xsd:restriction>
                                                                     </xsd:simpleType>
                                                                  </xsd:element>
                                                                  <xsd:element maxOccurs="1" minOccurs="0" name="QUANTITY_B">
                                                                     <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                                        <xsd:documentation>Quantity in Base Unit of Measure</xsd:documentation>
                                                                        <xsd:appinfo>
                                                                           <dc:description>Quantity in Base Unit of Measure</dc:description>
                                                                           <dc:title>Qty BUoM</dc:title>
                                                                        </xsd:appinfo>
                                                                     </xsd:annotation>
                                                                     <xsd:simpleType>
                                                                        <xsd:restriction base="xsd:decimal">
                                                                           <xsd:totalDigits value="13"/>
                                                                           <xsd:fractionDigits value="3"/>
                                                                        </xsd:restriction>
                                                                     </xsd:simpleType>
                                                                  </xsd:element>
                                                                  <xsd:element maxOccurs="1" minOccurs="0" name="UNIT_B">
                                                                     <xsd:annotation xmlns:dc="http://purl.org/dc/elements/1.1/">
                                                                        <xsd:documentation>Base Unit of Measure</xsd:documentation>
                                                                        <xsd:appinfo>
                                                                           <dc:description>Base Unit of Measure</dc:description>
                                                                           <dc:title>BUn</dc:title>
                                                                        </xsd:appinfo>
                                                                     </xsd:annotation>
                                                                     <xsd:simpleType>
