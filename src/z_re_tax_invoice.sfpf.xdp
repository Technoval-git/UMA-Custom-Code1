{
  var value = this.rawValue.toString();
  var numDigits = 0;
  for (i = 0; i &lt; value.length; i++)
  {
    if (value.charAt(i) &gt;= '0' &amp;&amp; value.charAt(i) &lt;= '9')
      numDigits++;
  }
  return (numDigits &lt;= maxDigits);
}
this.isNull || (testTotalDigits(15));
</script></validate><desc><text name="Schema-Anmerkung">Gesamtbetrag der Rechnung</text></desc><?digestForSAP digest="8d79b288b889aadcd7f71c9b3eba2f0b"?></field><border><edge/><edge presence="hidden"/><edge/><edge presence="hidden"/><corner/></border><?templateDesigner expand 0?></subform><?templateDesigner expand 1?></subform><subform layout="tb" name="T_RA_RESERVATION"><margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/><draw name="Note" w="175mm"><value><exData xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" contentType="text/html" xft-xliff:id="N2717" xliff:rid="D62DA5A8-56A4-413F-A3B5-B9BB74B1B448">
