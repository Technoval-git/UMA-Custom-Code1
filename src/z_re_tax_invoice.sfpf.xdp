                     </exData></value><ui><textEdit/></ui><font typeface="Myriad Pro"/><margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/><assist><speak disable="1"/></assist></draw><field h="5.0502mm" name="TOTALGROSSAMOUNT" presence="hidden" w="37mm"><ui><numericEdit><border><edge presence="hidden"/></border><margin/></numericEdit></ui><font typeface="Arial"/><margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/><para vAlign="middle"/><value><decimal/></value><bind match="dataRef" ref="$record.MAIN.SUMMARY.CLEARED.TOTALGROSSAMOUNT"/><desc><text name="Schema-Anmerkung">Gesamtbetrag der Rechnung</text></desc><validate><script contentType="application/x-javascript">function testTotalDigits(maxDigits)
{
  var value = this.rawValue.toString();
  var numDigits = 0;
  for (i = 0; i &lt; value.length; i++)
  {
    if (value.charAt(i) &gt;= '0' &amp;&amp; value.charAt(i) &lt;= '9')
      numDigits++;
  }
  return (numDigits &lt;= maxDigits);
}
this.isNull || (testTotalDigits(15));
</script></validate><assist><speak disable="1"/></assist><?digestForSAP digest="54e1b202b4e410ecfbd7cae6004d2765"?></field><?templateDesigner expand 1?></subform><margin topInset="5mm"/><?templateDesigner expand 0?></subform><subform layout="tb" name="TransactionCurrenySubtotal" w="175mm"><bind match="none"/><margin bottomInset="0mm" topInset="3mm"/><draw minH="10mm" name="TransactionCurrencySubtotal" w="175mm"><ui><textEdit/></ui><value><text xliff:rid="D9116A48-03FA-477A-9DB9-AD90DD44A086">The invoice amount includes items that were posted in a currency other than the local currency.
