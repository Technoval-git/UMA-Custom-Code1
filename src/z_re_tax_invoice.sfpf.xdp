xfa:embed="#floatingField019169" xfa:embedMode="raw" xfa:embedType="uri"/><span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField015724" xfa:embedMode="raw" xfa:embedType="uri"/><span style="xfa-spacerun:yes"> </span></p></body></value><value id="N284">Rücksendeadresse</value><value id="N2842">Vertragsnummer</value><value id="N2958"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="1.4.4293.0"><p style="tab-interval:0.393in;font-family:Arial;font-size:8pt;font-weight:bold">Fällig am</p></body></value><value id="N2994"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="1.4.4293.0"><p style="tab-interval:0.393in;font-family:Arial;font-size:8pt;font-weight:bold">Position</p></body></value><value id="N3030"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="1.4.4293.0"><p style="text-align:right;tab-interval:0.393in;font-family:Arial;font-size:8pt;font-weight:bold">Betrag</p></body></value><value id="N3422">Rechnungsbetrag (brutto)</value><value id="N357">Empfänger</value><value id="N4116">Unterschrift</value><value id="N4214"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="2.4.6284.0"><p>Im Rechnungsbetrag enthaltene Steuern:<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField019895" xfa:embedMode="raw" xfa:embedType="uri"/><span style="xfa-spacerun:yes"> </span></p></body></value><value id="N4340"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="2.3.5062.0"><p style="tab-interval:0.393in;font-family:Arial;font-size:8pt;text-decoration:none">Zu Ihrer Information:<span style="xfa-spacerun:yes">   </span>Der Rechnungsbetrag entspricht<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField022200" xfa:embedMode="raw" xfa:embedType="uri"/><span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField003405" xfa:embedMode="raw" xfa:embedType="uri"/><span style="xfa-spacerun:yes"> </span></p></body></value><value id="N4356">Text Field</value><value id="N4379"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="1.4.4348.0"><p>Der Betrag von<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField028145" xfa:embedMode="raw" xfa:embedType="uri"/><span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField023281" xfa:embedMode="raw" xfa:embedType="uri"/> wird vom Konto<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField011942" xfa:embedMode="raw" xfa:embedType="uri"/>,<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField004827" xfa:embedMode="raw" xfa:embedType="uri"/>, BLZ<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField005436" xfa:embedMode="raw" xfa:embedType="uri"/>, abgebucht.</p></body></value><value id="N4431">Text Field</value><value id="N4658">Textfeld</value><value id="N4728">Textfeld</value><value id="N5057"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="1.4.4348.0"><p style="margin-bottom:3.6pt;tab-interval:0.393in">Sie erhalten eine Gutschrift über<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField014604" xfa:embedMode="raw" xfa:embedType="uri"/><span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField003902" xfa:embedMode="raw" xfa:embedType="uri"/>. Der Betrag wird auf Ihr Konto<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField000153" xfa:embedMode="raw" xfa:embedType="uri"/>,<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField000292" xfa:embedMode="raw" xfa:embedType="uri"/>, BLZ<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField012382" xfa:embedMode="raw" xfa:embedType="uri"/>, überwiesen.</p></body></value><value id="N506">Datum</value><value id="N5092-1">Dezimalfeld</value><value id="N5297">Textfeld</value><value id="N5367">Textfeld</value><value id="N5384-1"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="2.3.5062.0"><p style="margin-bottom:3.6pt;tab-interval:0.393in">Bitte überweisen Sie den Betrag von<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField032391" xfa:embedMode="raw" xfa:embedType="uri"/><span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField017421" xfa:embedMode="raw" xfa:embedType="uri"/> auf das unten genannte Konto.</p></body></value><value id="N5533-1">Dezimalfeld</value><value id="N5616"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="1.4.4348.0"><p style="margin-bottom:3.6pt;tab-interval:0.393in;font-family:Arial">Somit ergibt sich keine Forderung.</p></body></value><value id="N576">Rechnung</value><value id="N5810-1">Dezimalfeld</value><value id="N6102-1"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="2.3.5062.0"><p style="margin-bottom:3.6pt;tab-interval:0.393in">Sie erhalten eine Gutschrift über<span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField018716" xfa:embedMode="raw" xfa:embedType="uri"/><span style="xfa-spacerun:yes"> </span><span xfa:embed="#floatingField019718" xfa:embedMode="raw" xfa:embedType="uri"/>.</p></body></value><value id="N6251-1">Dezimalfeld</value><value id="N656">Sachbearbeiter</value><value id="N709">Gutschrift</value><value id="N777"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="1.4.4348.0"><p><span xfa:embed="#floatingField029358" xfa:embedMode="raw" xfa:embedType="uri"/></p></body></value><value id="N796">Telefon</value><value id="N959"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" xfa:APIVersion="1.4.4348.0"><p><span xfa:embed="#floatingField026962" xfa:embedMode="raw" xfa:embedType="uri"/></p></body></value><value id="N982">Telefax</value></tags><?formServer defaultPDFRenderFormat acrobat9.0static?><subform layout="tb" locale="ambient" name="data"><pageSet name="Invoice"><pageArea id="Page1" name="FirstPage"><occur max="1" min="1"/><medium long="297mm" short="210mm" stock="a4"/><subform h="10mm" name="Logo" w="20mm" x="21mm" y="10mm"><border><edge presence="hidden"/></border><bind match="none"/><field access="nonInteractive" h="10mm" name="LOGO" w="20mm"><value><image contentType="image/gif">R0lGODlhQQGfAPcAAAAAAIAAAACAAICAAAAAgIAAgACAgMDAwMDcwKbK8AAAANTQyP///wAAAAAA
