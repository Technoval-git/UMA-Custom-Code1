{
  var value = this.rawValue.toString();
  var numDigits = 0;
  for (i = 0; i &lt; value.length; i++)
  {
    if (value.charAt(i) &gt;= '0' &amp;&amp; value.charAt(i) &lt;= '9')
      numDigits++;
  }
  return (numDigits &lt;= maxDigits);
}
this.isNull || (testTotalDigits(15));
</script></validate><desc><text name="Schema-Anmerkung">Gesamtbetrag der Rechnung</text></desc><?digestForSAP digest="8d79b288b889aadcd7f71c9b3eba2f0b"?></field><border><edge/><edge presence="hidden"/><edge/><edge presence="hidden"/><corner/></border><?templateDesigner expand 0?></subform><?templateDesigner expand 1?></subform><subform layout="tb" minH="7mm" name="Tax" w="175mm" y="35.62mm"><bind match="none"/><subform columnWidths="135mm 40mm" layout="table" name="T_RA_TAX_SUBTOTAL"><border><edge presence="hidden"/><corner presence="hidden"/></border><subform layout="row" name="HeaderTaxSubtotal"><assist role="TH"/><draw h="3mm" name="ContainedTaxes" w="30mm"><border><edge presence="hidden"/><corner presence="hidden" thickness="0.1778mm"/></border><ui><textEdit><margin/></textEdit></ui><font size="8pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/><para hAlign="center" vAlign="middle"/><assist><speak disable="1"/></assist></draw><draw h="3mm" name="TaxAmount" w="30mm"><border><edge presence="hidden"/><corner presence="hidden" thickness="0.1778mm"/></border><ui><textEdit><margin/></textEdit></ui><font size="8pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/><para hAlign="center" vAlign="middle"/><assist><speak disable="1"/></assist></draw><border><edge presence="hidden"/></border><occur max="-1"/><?templateDesigner expand 1?></subform><subform layout="row" name="DATA"><assist role="TR"/><draw h="4mm" name="ContainedTaxes" w="30mm"><border><edge presence="hidden"/><corner presence="hidden" thickness="0.1778mm"/></border><ui><textEdit><margin/></textEdit></ui><font baselineShift="0pt" size="8pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/><para marginLeft="0pt" marginRight="0pt" spaceAbove="0pt" spaceBelow="0pt" textIndent="0pt" vAlign="middle"/><value><exData xmlns:xft-xliff="http://www.xfa.org/schema/xfa-xliff/1.0/" contentTy