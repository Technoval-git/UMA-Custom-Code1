   <cls:CL_FP_CODING id="o5">
    <CL_FP_INTERFACE_DATA_CHANGED classVersion="1">
     <INTERFACE_DATA href="#o1"/>
    </CL_FP_INTERFACE_DATA_CHANGED>
    <CL_FP_CODING classVersion="1">
     <INPUT_PARAMETERS>
      <FPPARAMETER>CONTACTINFO</FPPARAMETER>
      <FPPARAMETER>CONDITIONS</FPPARAMETER>
      <FPPARAMETER>ITEM</FPPARAMETER>
      <FPPARAMETER>EKKO</FPPARAMETER>
      <FPPARAMETER>HEADER</FPPARAMETER>
      <FPPARAMETER>EKPO</FPPARAMETER>
     </INPUT_PARAMETERS>
     <OUTPUT_PARAMETERS>
      <FPPARAMETER>CREATEDBY</FPPARAMETER>
      <FPPARAMETER>V_VAT_TEXT</FPPARAMETER>
      <FPPARAMETER>V_STCEG</FPPARAMETER>
      <FPPARAMETER>TERMS_AND_COND</FPPARAMETER>
      <FPPARAMETER>TOTALCURRENCY</FPPARAMETER>
      <FPPARAMETER>GV_PURGRP</FPPARAMETER>
      <FPPARAMETER>OTHERCHARGES</FPPARAMETER>
      <FPPARAMETER>VAT</FPPARAMETER>
      <FPPARAMETER>DISCOUNT</FPPARAMETER>
      <FPPARAMETER>HEADERTEXT</FPPARAMETER>
      <FPPARAMETER>V_NAME1</FPPARAMETER>
      <FPPARAMETER>V_LIFNR</FPPARAMETER>
      <FPPARAMETER>V_ADRNR</FPPARAMETER>
      <FPPARAMETER>V_PO_BOX</FPPARAMETER>
      <FPPARAMETER>V_CITY1</FPPARAMETER>
      <FPPARAMETER>V_COUNTRY</FPPARAMETER>
      <FPPARAMETER>V_TEL_NUMBER</FPPARAMETER>
      <FPPARAMETER>V_FLAGCOMM6</FPPARAMETER>
      <FPPARAMETER>P_EBELN</FPPARAMETER>
      <FPPARAMETER>LT_ITEMD</FPPARAMETER>
      <FPPARAMETER>HEADERTEXT</FPPARAMETER>
      <FPPARAMETER>SHIPTODETAILS</FPPARAMETER>
      <FPPARAMETER>TOTALTEXT</FPPARAMETER>
      <FPPARAMETER>VBVAT</FPPARAMETER>
      <FPPARAMETER>V_STRAS</FPPARAMETER>
      <FPPARAMETER>V_PAYTERM</FPPARAMETER>
      <FPPARAMETER>V_STENR</FPPARAMETER>
     </OUTPUT_PARAMETERS>
     <INITIALIZATION>
      <FPCLINE>v_lifnr = header-lifnr.</FPCLINE>
      <FPCLINE>p_ebeln = header-ebeln.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>DATA lw_cond TYPE komvd.</FPCLINE>
      <FPCLINE>DATA lwa_headertext TYPE mmpur_print_t166k.</FPCLINE>
      <FPCLINE>DATA lv_amount TYPE bwert.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>lwa_headertext-txnam = p_ebeln.</FPCLINE>
      <FPCLINE>lwa_headertext-tdid  = &apos;F01&apos;.</FPCLINE>
      <FPCLINE>lwa_headertext-tdobject = &apos;EKKO&apos;.</FPCLINE>
      <FPCLINE>APPEND lwa_headertext TO headertext.</FPCLINE>
      <FPCLINE/>
      <FPCLINE/>
      <FPCLINE>SELECT knumv, kposn, kschl, kwert FROM prcd_elements INTO TABLE @DATA(lt_prcd_elements)</FPCLINE>
      <FPCLINE>    WHERE knumv = @header-knumv and kinak = @space.</FPCLINE>
      <FPCLINE>SELECT kschl FROM  zmm_po_cond INTO TABLE @DATA(lt_zmm_po_cond) WHERE cond_ind = &apos;OTHER&apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>LOOP AT lt_zmm_po_cond INTO DATA(lw_zmm_po_cond).</FPCLINE>
      <FPCLINE>  LOOP AT lt_prcd_elements INTO DATA(ls_prcd_elements) WHERE kschl = lw_zmm_po_cond-kschl.</FPCLINE>
      <FPCLINE>    othercharges = othercharges + ls_prcd_elements-kwert.</FPCLINE>
      <FPCLINE>  ENDLOOP.</FPCLINE>
      <FPCLINE>ENDLOOP.</FPCLINE>
      <FPCLINE/>
      <FPCLINE/>
      <FPCLINE>LOOP AT lt_prcd_elements INTO ls_prcd_elements WHERE kschl = &apos;YVDI&apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  discount = discount + ls_prcd_elements-kwert.</FPCLINE>
      <FPCLINE>ENDLOOP.</FPCLINE>
      <FPCLINE>CLEAR ls_prcd_elements.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>LOOP AT lt_prcd_elements INTO ls_prcd_elements WHERE kschl = &apos;MWVS&apos;.</FPCLINE>
      <FPCLINE>  vat = vat + ls_prcd_elements-kwert.</FPCLINE>
      <FPCLINE>ENDLOOP.</FPCLINE>
      <FPCLINE>*vbvat = header-netwr - vat.</FPCLINE>
      <FPCLINE>vbvat = header-netwr .</FPCLINE>
      <FPCLINE>CLEAR ls_prcd_elements.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>header-netwr = header-netwr + vat + othercharges .</FPCLINE>
      <FPCLINE>lv_amount = header-netwr.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>CALL FUNCTION &apos;ZMM_AMOUNT_TO_WORDS&apos;</FPCLINE>
      <FPCLINE>  EXPORTING</FPCLINE>
      <FPCLINE>    amount = lv_amount</FPCLINE>
      <FPCLINE>    waers  = header-waers</FPCLINE>
      <FPCLINE>  IMPORTING</FPCLINE>
      <FPCLINE>    a_word = totaltext.</FPCLINE>
      <FPCLINE/>
      <FPCLINE/>
      <FPCLINE>DATA ls_item TYPE mmpur_print_ekpo.</FPCLINE>
      <FPCLINE>DATA lwa_final TYPE zmm_po_str.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>READ TABLE item INTO ls_item INDEX 1.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>SELECT SINGLE werks name1 pfach pstlz ort01 land1 adrnr stras</FPCLINE>
      <FPCLINE>  FROM t001w</FPCLINE>
      <FPCLINE>  INTO (shiptodetails-werks, shiptodetails-name1, shiptodetails-pfach, shiptodetails-pstlz,</FPCLINE>
      <FPCLINE>  shiptodetails-ort01, shiptodetails-land1, shiptodetails-adrnr,shiptodetails-stras)</FPCLINE>
      <FPCLINE>  WHERE werks = ls_item-werks.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>IF shiptodetails-adrnr IS NOT INITIAL.</FPCLINE>
      <FPCLINE>  SELECT SINGLE tel_number</FPCLINE>
      <FPCLINE>    FROM adrc</FPCLINE>
      <FPCLINE>    INTO (shiptodetails-tel_number)</FPCLINE>
      <FPCLINE>    WHERE addrnumber = shiptodetails-adrnr.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>CLEAR: ls_item.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>SELECT SINGLE adrnr pfach name1 stras stenr stceg</FPCLINE>
      <FPCLINE>  FROM lfa1</FPCLINE>
      <FPCLINE>  INTO (v_adrnr, v_po_box, v_name1, v_stras, v_stenr, v_stceg)</FPCLINE>
      <FPCLINE>  WHERE lifnr = v_lifnr.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>IF v_adrnr IS NOT INITIAL.</FPCLINE>
      <FPCLINE>  SELECT SINGLE city1 country tel_number flagcomm6</FPCLINE>
      <FPCLINE>    FROM adrc</FPCLINE>
      <FPCLINE>    INTO (v_city1, v_country, v_tel_number, v_flagcomm6)</FPCLINE>
      <FPCLINE>    WHERE addrnumber = v_adrnr.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE>SELECT ebeln, ebelp,etenr,eindt FROM eket INTO TABLE @DATA(lt_eket)  WHERE ebeln = @header-ebeln.</FPCLINE>
      <FPCLINE>SELECT ebeln, ebelp,matnr,txz01,menge,meins,netpr,netwr FROM ekpo INTO TABLE @DATA(lt_ekpo)</FPCLINE>
      <FPCLINE>  WHERE ebeln = @header-ebeln AND loekz  NE &apos;L&apos; .</FPCLINE>
      <FPCLINE>LOOP AT lt_ekpo INTO DATA(ls_ekpo).</FPCLINE>
      <FPCLINE>  lwa_final-ebelp = ls_ekpo-ebelp. &quot;+2(3).</FPCLINE>
      <FPCLINE>  SHIFT lwa_final-ebelp LEFT DELETING LEADING &apos;0&apos;.</FPCLINE>
      <FPCLINE>  lwa_final-matnr = ls_ekpo-matnr.</FPCLINE>
      <FPCLINE>  lwa_final-maktx = ls_ekpo-txz01.</FPCLINE>
      <FPCLINE>  lwa_final-menge = ls_ekpo-menge.</FPCLINE>
      <FPCLINE>  lwa_final-meins = ls_ekpo-meins.</FPCLINE>
      <FPCLINE>  lwa_final-netpr = ls_ekpo-netpr.</FPCLINE>
      <FPCLINE>  lwa_final-netwr = ls_ekpo-netwr.</FPCLINE>
      <FPCLINE>  READ TABLE lt_eket INTO DATA(ls_eket) WITH KEY ebeln = ls_ekpo-ebeln</FPCLINE>
      <FPCLINE>                                                 ebelp = ls_ekpo-ebelp.</FPCLINE>
      <FPCLINE>  IF sy-subrc = 0.</FPCLINE>
      <FPCLINE>    lwa_final-eq_eindt = ls_eket-eindt.</FPCLINE>
      <FPCLINE>  ENDIF.</FPCLINE>
      <FPCLINE>  APPEND lwa_final TO lt_itemd.</FPCLINE>
      <FPCLINE>  CLEAR: lwa_final.</FPCLINE>
      <FPCLINE>ENDLOOP.</FPCLINE>
      <FPCLINE>CONCATENATE header-ekgrp &apos;-&apos; contactinfo-eknam INTO gv_purgrp.</FPCLINE>
      <FPCLINE>CONCATENATE &apos;Total PO Value (&apos; header-waers &apos;)&apos; INTO totalcurrency .</FPCLINE>
      <FPCLINE/>
      <FPCLINE/>
      <FPCLINE>SELECT SINGLE terms_and_cond INTO terms_and_cond FROM zmm_po_trm_cond WHERE ekorg = header-ekorg</FPCLINE>
      <FPCLINE>  AND ekgrp = header-ekgrp.</FPCLINE>
      <FPCLINE>IF terms_and_cond IS INITIAL.</FPCLINE>
      <FPCLINE>  terms_and_cond = &apos;ZMM_TERMS_CONDITION_DEF&apos;.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>SELECT SINGLE vtext FROM tvzbt INTO v_payterm WHERE spras = &apos;E&apos; AND zterm = header-zterm.</FPCLINE>
      <FPCLINE>*BREAK-POINT.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>CASE header-bukrs.</FPCLINE>
      <FPCLINE>  WHEN 2100.</FPCLINE>
      <FPCLINE>    v_vat_text = &apos;VAT 5%&apos;.</FPCLINE>
      <FPCLINE>  WHEN 2200.</FPCLINE>
      <FPCLINE>    v_vat_text = &apos;VAT 5%&apos;.</FPCLINE>
      <FPCLINE>  WHEN 1000.</FPCLINE>
      <FPCLINE>    v_vat_text = &apos;VAT 15%&apos;.</FPCLINE>
      <FPCLINE>  WHEN OTHERS.</FPCLINE>
      <FPCLINE>    v_vat_text = &apos;VAT %&apos;.</FPCLINE>
      <FPCLINE>ENDCASE.</FPCLINE>
      <FPCLINE/>
      <FPCLINE/>
      <FPCLINE/>
      <FPCLINE>*select single name_textc from user_addr into  createdby where bname = header-ernam.</FPCLINE>
      <FPCLINE>DATA lv_usr03 TYPE usr03.</FPCLINE>
      <FPCLINE>CALL FUNCTION &apos;SUSR_SHOW_USER_DETAILS&apos;</FPCLINE>
      <FPCLINE>  EXPORTING</FPCLINE>
      <FPCLINE>    bname      = header-ernam</FPCLINE>
      <FPCLINE>    mandt      = sy-mandt</FPCLINE>
      <FPCLINE>    no_display = &apos;X&apos;</FPCLINE>
      <FPCLINE>  CHANGING</FPCLINE>
      <FPCLINE>    user_usr03 = lv_usr03.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>CONCATENATE lv_usr03-name1 lv_usr03-name2 INTO createdby SEPARATED BY space.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>IF srvlines IS INITIAL.</FPCLINE>
      <FPCLINE>  lv_flag_service = abap_false.</FPCLINE>
      <FPCLINE>ELSE.</FPCLINE>
      <FPCLINE>  lv_flag_service = abap_true.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>SORT lt_itemd BY ebelp.</FPCLINE>
     </INITIALIZATION>
     <FORMS/>
    </CL_FP_CODING>
   </cls:CL_FP_CODING>
